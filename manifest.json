{
  "manifest_version": 3,
  "name": "Hybrid Web Translator",
  "version": "6.0.1",
  "description": "Translate pages with local dictionaries, optional manual fallback, and private local translation through LocalTranslator Studio.",
  "permissions": [
    "storage",
    "activeTab",
    "unlimitedStorage",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Hybrid Web Translator"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "languages.js",
        "dictionaries/registry.js",
        "dictionaries/zh-general.js",
        "dictionaries/vi-general.js",
        "dictionaries/th-general.js",
        "dictionaries/ru-general.js",
        "dictionaries/zh.js",
        "dictionaries/vi.js",
        "dictionaries/th.js",
        "dictionaries/ru.js",
        "dictionaries/pt-general.js",
        "dictionaries/es-general.js",
        "dictionaries/fr-general.js",
        "dictionaries/ja-general.js",
        "dictionaries/pt.js",
        "dictionaries/es.js",
        "dictionaries/fr.js",
        "dictionaries/ja.js",
        "engine.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "author": "Marcus Silva"
}
